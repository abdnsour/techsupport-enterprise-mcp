# ==============================================================================
# Oracle Autonomous Database & OCI Generative AI MCP Server Configuration
# ==============================================================================

# OCI Generative AI Service
OCI_API_KEY_ONE=your_oci_genai_api_key_or_token
PROJECT_OCID=ocid1.compartment.oc1..your_compartment_ocid

# Oracle Autonomous Database Credentials
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password
SCHEMA=RECSYS_NEW
WALLET_PASSWORD=your_wallet_password
WALLET_DIR=Wallet_CLOUDEX

# Database TNS / DSN Descriptor (TCPS 1522 with mTLS)
DB_DSN=(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1522)(host=adb.us-phoenix-1.oraclecloud.com))(connect_data=(service_name=your_service_name_medium.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))

# Model Context Protocol (MCP) Server Configuration
MCP_SERVER_LABEL=tech_support_mcp
MCP_SERVER_DESCRIPTION=Enterprise Technical Support & Oracle Autonomous Database MCP Server
MCP_SERVER_URL=http://localhost:8000/sse
MCP_REQUIRE_APPROVAL=never

# Langfuse Observability & Tracing (Optional)
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com
